# Copy to .env (never commit .env). The same names go in GitHub > Settings > Secrets and variables > Actions.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# npm run gen:key
TOKEN_ENCRYPTION_KEY=
# claude setup-token (only needed in GitHub secrets; locally you are already logged in to Claude Code)
CLAUDE_CODE_OAUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional, only if TikTok will not accept the localhost Desktop flow:
# TIKTOK_REDIRECT_URI=https://xa0z.github.io/pip-studio/callback.html
# Optional paid fallback (off by default): if set, the Anthropic API is used instead of Claude Code
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Pip Studio (Telegram bot) ----------
# Same names go in Vercel (Project > Settings > Environment Variables) and GitHub secrets.
OWNER_TELEGRAM_ID=
TELEGRAM_WEBHOOK_SECRET=
BOT_USERNAME=
# npm run gen:key (a different key from TOKEN_ENCRYPTION_KEY)
MASTER_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_BASE_URL=https://your-app.vercel.app
GITHUB_REPO=Xa0z/pip-studio
GH_DISPATCH_TOKEN=
# Only after TikTok approves the app audit:
# ALLOW_AUTO_FOR_ALL=true
# ACTIONS_MINUTES_LIMIT=1700
